# Maintainer: Vixalt <vixaltyalt@gmail.com>
pkgname=vixglitcher
pkgver=1.0.0
pkgrel=1
pkgdesc="Dark Neon Lilac mpv Video Player for Arch Linux (Wayland & X11)"
arch=('x86_64')
url="https://github.com/Vixalt-Yalt/vixaltglitcher"
license=('MIT')
depends=('mpv' 'sdl2' 'hicolor-icon-theme')
optdepends=(
  'yt-dlp: stream online videos via URL modal'
  'zenity: optional GTK native file dialog'
  'kdialog: optional KDE native file dialog'
)
makedepends=('gcc' 'make' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Vixalt-Yalt/vixaltglitcher/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/vixaltglitcher-$pkgver"
  make PREFIX=/usr
}

package() {
  cd "$srcdir/vixaltglitcher-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}
